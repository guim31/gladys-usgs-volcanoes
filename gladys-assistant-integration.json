  "scene_actions": [
    {
      "key": "read_volcanoes",
      "label": {
        "en": "USGS volcanoes: read the levels",
        "fr": "Volcans USGS : lire les niveaux",
        "de": "USGS-Vulkane: Stufen lesen",
        "es": "Volcanes USGS: leer los niveles"
      },
      "description": {
        "en": "The followed volcanoes, and the nearby ones above normal, as one sentence to send by message or read aloud.",
        "fr": "Les volcans suivis, et les volcans proches au-dessus de la normale, en une phrase à envoyer par message ou à lire.",
        "de": "Die verfolgten Vulkane und die nahen über normal als ein Satz, per Nachricht zu senden oder vorzulesen.",
        "es": "Los volcanes seguidos, y los cercanos por encima de lo normal, en una frase para enviar por mensaje o leer en voz alta."
      },
      "timeout_seconds": 60,
      "outputs": [
