    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "Sources and limits",
        "fr": "Sources et limites",
        "de": "Quellen und Grenzen",
        "es": "Fuentes y límites"
      },
      "description": {
        "en": "Data: USGS Volcano Hazards Program (public domain), read without account. Not affiliated with the USGS. Not a safety alert system: follow the official notices and local authorities.",
        "fr": "Données : USGS Volcano Hazards Program (domaine public), lues sans compte. Non affiliée à l'USGS. Pas un système d'alerte de sécurité : suivez les bulletins officiels et les autorités locales.",
        "de": "Daten: USGS Volcano Hazards Program (gemeinfrei), ohne Konto gelesen. Nicht mit dem USGS verbunden. Kein Sicherheitswarnsystem: Folge den offiziellen Meldungen und den örtlichen Behörden.",
        "es": "Datos: USGS Volcano Hazards Program (dominio público), leídos sin cuenta. Sin afiliación con el USGS. No es un sistema de alerta de seguridad: siga los boletines oficiales y a las autoridades locales."
      },
      "links": [
        {
          "url": "https://www.usgs.gov/programs/VHP/about-alert-levels",
          "label": {
            "en": "About the alert levels",
            "fr": "À propos des niveaux",
            "de": "Über die Warnstufen",
            "es": "Acerca de los niveles"
          }
        }
      ]
    }
